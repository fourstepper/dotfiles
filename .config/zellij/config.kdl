// THIS FILE WAS AUTOGENERATED BY ZELLIJ, THE PREVIOUS FILE AT THIS LOCATION WAS COPIED TO: /Users/robinopletal/.config/zellij/config.kdl.bak
//

keybinds clear-defaults=true {
    normal {
        bind "Ctrl Shift left" { MoveTab "left"; }
        bind "Ctrl Shift right" { MoveTab "right"; }
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
        bind "Alt 5" { GoToTab 5; }
        bind "Alt 6" { GoToTab 6; }
        bind "Alt 7" { GoToTab 7; }
        bind "Alt 8" { GoToTab 8; }
        bind "Alt 9" { GoToTab 9; }
        bind "Ctrl a" { SwitchToMode "tmux"; }
        bind "Alt d" { Detach; }
        bind "Alt h" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus"
                payload "left"
                floating false
                move_mod "ctrl"
            }
        }
        bind "Alt j" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus"
                payload "down"
                floating false
                move_mod "ctrl"
            }
        }
        bind "Alt k" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus"
                payload "up"
                floating false
                move_mod "ctrl"
            }
        }
        bind "Alt l" {
            MessagePlugin "https://github.com/hiasr/vim-zellij-navigator/releases/download/0.3.0/vim-zellij-navigator.wasm" {
                name "move_focus"
                payload "right"
                floating false
                move_mod "ctrl"
            }
        }
        // Alt-o = fzf session picker (like tmux M-o popup). Most-recent other
        // session on top and pre-highlighted, so Enter switches to it. Current
        // session excluded. tab/shift-tab to move, type to filter. Type a name
        // with no match + Enter to create+switch to a new session.
        bind "Alt o" {
            Run "bash" "-c" "out=$(zellij ls -rn | grep -v 'EXITED' | grep -v '(current)' | awk '{print $1}' | fzf --reverse --no-sort --cycle --print-query --header=jump-to-session --bind=shift-tab:up,tab:down); q=$(printf '%s\\n' \"$out\" | head -n1); s=$(printf '%s\\n' \"$out\" | tail -n +2); name=${s:-$q}; [ -n \"$name\" ] && zellij action switch-session \"$name\"" {
                floating true
                close_on_exit true
                name "jump-to-session"
            }
        }
        // Alt-s = full session manager (browse / new / kill).
        bind "Alt s" {
            LaunchOrFocusPlugin "zellij:session-manager" {
                floating true
            }
        }
    }
    locked {
        bind "Ctrl g" { SwitchToMode "normal"; }
    }
    scroll {
        bind "/" { SwitchToMode "entersearch"; SearchInput 0; }
        bind "Ctrl b" { PageScrollUp; }
        bind "e" { EditScrollback; SwitchToMode "normal"; }
        bind "Ctrl f" { PageScrollDown; }
        bind "j" { ScrollDown; }
        bind "k" { ScrollUp; }
    }
    search {
        bind "n" { Search "down"; }
        bind "p" { Search "up"; }
    }
    shared_except "locked" {
        bind "Ctrl g" { SwitchToMode "locked"; }
        bind "Ctrl q" { Quit; }
    }
    shared_among "scroll" "search" {
        bind "q" { SwitchToMode "normal"; }
    }
    shared_among "scroll" "search" "renametab" "tmux" {
        bind "esc" { SwitchToMode "normal"; }
    }
    shared_among "scroll" "search" "tmux" {
        bind "Ctrl c" { SwitchToMode "normal"; }
    }
    entersearch {
        bind "Ctrl c" { SwitchToMode "scroll"; }
        bind "esc" { SwitchToMode "scroll"; }
        bind "enter" { SwitchToMode "search"; }
    }
    tmux {
        bind "," { SwitchToMode "renametab"; }
        bind "$" {
            Run "bash" "/Users/robinopletal/.config/zellij/rename-session.sh" {
                floating true
                close_on_exit true
                name "rename-session"
            }
            SwitchToMode "normal";
        }
        bind "<" { MoveTab "left"; }
        bind ">" { MoveTab "right"; }
        bind "[" { SwitchToMode "scroll"; }
        bind "Ctrl a" { Write 1; SwitchToMode "normal"; }
        bind "c" { NewTab; SwitchToMode "normal"; }
        bind "d" { Detach; }
        bind "h" { Resize "Increase left"; }
        bind "j" { Resize "Increase down"; }
        bind "k" { Resize "Increase up"; }
        bind "l" { Resize "Increase right"; }
        bind "v" { NewPane "right"; SwitchToMode "normal"; }
        bind "w" { NewPane "down"; SwitchToMode "normal"; }
        bind "x" { CloseFocus; SwitchToMode "normal"; }
        bind "z" { ToggleFocusFullscreen; SwitchToMode "normal"; }
    }
}
