// Master-left + fibonacci-spiral tiling, cycled with `Ctrl-a space`
// (NextSwapLayout) the way `prefix + space` cycles layouts in tmux.
//
// The first pane in the tab owns the left half; every pane after it spirals
// through the right half, alternating split direction. Zellij fills these
// slots in pane order rather than focus order, so `Ctrl-a space` and
// `Ctrl-a enter` first walk the focused pane leftwards into the master slot
// (see the MovePane binds in config.kdl).
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab {
        pane
    }

    swap_tiled_layout name="fibonacci" {
        tab exact_panes=1 {
            pane
        }
        tab exact_panes=2 {
            pane split_direction="vertical" {
                pane
                pane
            }
        }
        tab exact_panes=3 {
            pane split_direction="vertical" {
                pane
                pane {
                    pane
                    pane
                }
            }
        }
        tab exact_panes=4 {
            pane split_direction="vertical" {
                pane
                pane {
                    pane
                    pane split_direction="vertical" {
                        pane
                        pane
                    }
                }
            }
        }
        tab exact_panes=5 {
            pane split_direction="vertical" {
                pane
                pane {
                    pane
                    pane split_direction="vertical" {
                        pane
                        pane {
                            pane
                            pane
                        }
                    }
                }
            }
        }
        tab exact_panes=6 {
            pane split_direction="vertical" {
                pane
                pane {
                    pane
                    pane split_direction="vertical" {
                        pane
                        pane {
                            pane
                            pane split_direction="vertical" {
                                pane
                                pane
                            }
                        }
                    }
                }
            }
        }
        tab exact_panes=7 {
            pane split_direction="vertical" {
                pane
                pane {
                    pane
                    pane split_direction="vertical" {
                        pane
                        pane {
                            pane
                            pane split_direction="vertical" {
                                pane
                                pane {
                                    pane
                                    pane
                                }
                            }
                        }
                    }
                }
            }
        }
        // Seven splits deep is past what zellij will place - it drops such a
        // layout and falls back - so from eight panes on the spiral stops
        // deepening and its tail splits evenly instead.
        tab min_panes=8 {
            pane split_direction="vertical" {
                pane
                pane {
                    pane
                    pane split_direction="vertical" {
                        pane
                        pane {
                            pane
                            pane split_direction="vertical" {
                                pane
                                pane {
                                    children
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Uncomment either of these to give `Ctrl-a space` something to cycle
    // into; with fibonacci alone the bind only promotes the focused pane.
    // /- is KDL's slashdash: it comments out the whole node that follows.
    /-swap_tiled_layout name="even-columns" {
        tab min_panes=2 {
            pane split_direction="vertical" {
                children
            }
        }
    }

    /-swap_tiled_layout name="even-rows" {
        tab min_panes=2 {
            pane {
                children
            }
        }
    }
}
